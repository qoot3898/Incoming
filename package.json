{
  "name": "qoot-temporary-labor-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "gen:api": "node scripts/normalize-openapi.mjs && openapi-typescript ./openapi/openapi.normalized.json -o ./src/types/api.generated.ts",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm run lint && npm run i18n:check",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^6.4.12",
    "@mui/material": "^6.4.12",
    "@mui/x-data-grid": "^7.29.0",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.8.4",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^6.30.0",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "openapi-typescript": "^7.6.1",
    "react-doctor": "^0.9.21",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^5.4.14"
  }
}
