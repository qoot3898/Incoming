# Base URL of the Temporary Labor API.
# Leave empty in development to use the Vite proxy (requests go to /api on the dev server).
VITE_API_BASE_URL=

# Target the Vite dev proxy forwards /api requests to (development only).
# Use https: the API redirects http to https, and a redirect through the proxy ends in a CORS error.
VITE_DEV_PROXY_TARGET=https://qoottemporarylabor.runasp.net
